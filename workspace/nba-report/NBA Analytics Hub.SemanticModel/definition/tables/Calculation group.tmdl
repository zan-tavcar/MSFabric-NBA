	measure 'Games Won' =
			
			CALCULATE(
			    COUNT('games'[id]),
			    'games'[status] = "Final",
			    'games'[home_team_score] > 'games'[visitor_team_score],
			    USERELATIONSHIP('teams'[id], 'games'[hometeam_id]), ALL(games)
			)
			+
			CALCULATE(
			    COUNT('games'[id]),
			    'games'[status] = "Final",
			    'games'[visitor_team_score] > 'games'[home_team_score],
			    USERELATIONSHIP('teams'[id], 'games'[visitor_teamid]), ALL(games)
