			VAR RankedGames =
			    ADDCOLUMNS (
			        AllGamesForTeam,
			        "GameRank",
			        RANKX (
			            AllGamesForTeam,
			            games[date],
			            ,
			            DESC
			        )
			    )
			VAR Top5GameIds =
			    SELECTCOLUMNS (
			        FILTER (RankedGames, [GameRank] <= 100),
			        "GameId", games[id]
			    )
