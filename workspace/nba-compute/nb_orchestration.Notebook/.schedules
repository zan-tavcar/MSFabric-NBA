{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/gitIntegration/schedules/1.0.0/schema.json",
  "schedules": [
    {
      "enabled": false,
      "jobType": "Execute",
      "configuration": {
        "type": "Daily",
        "startDateTime": "2025-11-25T00:00:00",
        "endDateTime": "3000-12-31T23:59:00",
        "localTimeZoneId": "Romance Standard Time",
        "times": [
          "08:00"
        ]
      }
    },
    {
      "enabled": false,
      "jobType": "Execute",
      "configuration": {
        "type": "Weekly",
        "startDateTime": "2025-11-25T00:00:00",
        "endDateTime": "3000-12-31T23:59:00",
        "localTimeZoneId": "Romance Standard Time",
        "times": [
          "08:00"
        ],
        "weekdays": [
          "Sunday"
        ]
      }
    },
    {
      "enabled": true,
      "jobType": "Execute",
      "configuration": {
        "type": "Monthly",
        "startDateTime": "2025-11-30T00:00:00",
        "endDateTime": "2026-11-30T23:59:00",
        "localTimeZoneId": "Romance Standard Time",
        "times": [
          "12:00"
        ],
        "recurrence": 1,
        "occurrence": {
          "occurrenceType": "DayOfMonth",
          "dayOfMonth": 1
        }
      }
    }
  ]
}