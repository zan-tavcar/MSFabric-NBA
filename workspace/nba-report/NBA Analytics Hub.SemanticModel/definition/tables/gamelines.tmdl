	measure Assists = AVERAGE(gamelines[ast])
		formatString: 0
		lineageTag: 06a7c7fc-fa20-4a02-9747-73904aa71edb

		changedProperty = Name

		annotation PBI_FormatHint = {"isDecimal":true}

	measure AssistsRank = ```
			SWITCH(SELECTEDVALUE('Calculation group'[Calculation group column]),
			"Daily", RANKX(ALL(players), CALCULATE([Assists]),,DESC,Dense),
			"Season", RANKX(ALL(players), [AvgAssistsSeason],,DESC,Dense))
			
			
			```
		lineageTag: f7cb3ba6-7623-452b-943e-0819c306a63e

		changedProperty = Name

