	measure 'Conference Rank' =
			
			RANKX(
			    FILTER(
			        ALL('teams'),
			        'teams'[conference] = MAX('teams'[conference])
			    ),
			    [Games Behind],
			    ,
			    ASC,
			    Skip
			)
		lineageTag: 2a666ea7-ec24-4f21-93b6-65f066d16412

	measure 'Games Behind' = ```
			
			VAR MaxWins = 
			    MAXX(
			        FILTER(
			            ALL('teams'),
			            'teams'[conference] = MAX('teams'[conference])
			        ),
			        [Games Won]
			    )
			VAR MinLosses = 
			    MINX(
			        FILTER(
			            ALL('teams'),
			            'teams'[conference] = MAX('teams'[conference])
			        ),
			        [Games Lost]
			    )
			VAR TeamWins = [Games Won]
			VAR TeamLosses = [Games Lost]
			RETURN
			    DIVIDE(
			        (MaxWins - TeamWins) + (TeamLosses - MinLosses),
			        2
			    )
			```
		formatString: 0.0
		lineageTag: 89e56875-0762-43d9-b9ca-24c2c1724553

	measure 'Games Lost' = ```
			
			CALCULATE(
			    COUNT('games'[id]),
			    'games'[status] = "Final",
			    'games'[home_team_score] < 'games'[visitor_team_score],
			    USERELATIONSHIP('teams'[id], 'games'[hometeam_id]), ALL(games)
			)
			+
			CALCULATE(
			    COUNT('games'[id]),
			    'games'[status] = "Final",
			    'games'[visitor_team_score] < 'games'[home_team_score],
			    USERELATIONSHIP('teams'[id], 'games'[visitor_teamid]), ALL(games)
			)
			
			```
		formatString: 0
		lineageTag: 0d5d2095-6cc5-4d9c-9077-f52bbc049e7a

	measure 'Games Played' = ```
			
			CALCULATE(
			    COUNT('games'[id]),
			    'games'[status] = "Final",
			    USERELATIONSHIP('teams'[id],'games'[visitor_teamid]), ALL(games)
			) + 
			CALCULATE(
			    COUNT('games'[id]),
			    'games'[status] = "Final",
			    USERELATIONSHIP('teams'[id],'games'[hometeam_id]), ALL(games)
			)
			```
		formatString: 0
		lineageTag: 3267c043-fdad-41bb-ac83-76eb8dbfaba7

	measure Last5 = ```
			
			VAR HomeGames =
			    TOPN(
			        5,
			        FILTER(
			            ALL('games'),
			            'games'[hometeam_id] = MAX('teams'[id]) &&
			            'games'[status] = "Final"
			        ),
			        'games'[date], -- Sort by game date
			        DESC
			    )
			VAR AwayGames =
			    TOPN(
			        5,
			        FILTER(
			            ALL('games'),
			            'games'[awayteam_id] = MAX('teams'[id]) &&
			            'games'[status] = "Final"
			        ),
			        'games'[date],
			        DESC
			    )
			VAR CombinedGames =
			    UNION(HomeGames, AwayGames)
			VAR Last5Games =
			    TOPN(
			        5,
			        CombinedGames,
			        'games'[date],
			        DESC
			    )
			VAR Results =
			    ADDCOLUMNS(
			        Last5Games,
			        "Result",
			        IF(
			            'games'[hometeam_id] = MAX('teams'[id]),
			            IF('games'[home_team_score] > 'games'[visitor_team_score], "W", "L"),
			            IF('games'[visitor_team_score] > 'games'[home_team_score], "W", "L")
			        )
			    )
			VAR FinalString =
			    CONCATENATEX(
			        Results,
			        [Result],
			        "",
			        'games'[date], -- Sort by date
			        DESC
			    )
			RETURN
			    FinalString
			
			```
		lineageTag: 2a6db761-c824-46df-b323-b029d8030e7f

