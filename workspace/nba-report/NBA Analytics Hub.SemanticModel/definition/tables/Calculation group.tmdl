	measure Last5SVG = ```
			
			VAR Last5 = [Last5] // Example sequence of wins (W) and losses (L)
			VAR datauriPrefix = "data:image/svg+xml;utf8,"
			VAR RectWidth = 100 // Increased width for better readability
			VAR RectHeight = 100 // Increased height for better readability
			VAR RectSpacing = 10
			VAR StartX = 5
			VAR SVGContent =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='" & 
			    FORMAT((LEN(Last5) * (RectWidth + RectSpacing)) - RectSpacing + 2 * StartX, "0") & 
			    "' height='300' viewBox='0 0 " & FORMAT((LEN(Last5) * (RectWidth + RectSpacing)) - RectSpacing + 2 * StartX, "0") & " 50'>"
			    & CONCATENATEX(
			        ADDCOLUMNS(
			            GENERATESERIES(1, LEN(Last5)),
			            "Result", MID(Last5, [Value], 1),
			            "Color", IF(MID(Last5, [Value], 1) = "W", "#00C620", "#C51617"),
			            "XPos", StartX + ([Value] - 1) * (RectWidth + RectSpacing)
			        ),
			        "<rect x='" & [XPos] & "' y='10' width='" & RectWidth & "' height='" & RectHeight & "' fill='" & [Color] & "' rx='4'/>"
			        & "<text x='" & [XPos] + (RectWidth / 2) & "' y='28' text-anchor='middle' font-family='Segoe UI' font-size='16' fill='#B3B3B3'>" 
			        & [Result] & "</text>"
			    )
			    & "</svg>"
			RETURN
			    datauriPrefix & SVGContent
			
			```
		lineageTag: e1c0dcc9-514d-40fd-b2a1-7bd51c734686
		dataCategory: ImageUrl

	measure 'Conference Rank Label' =
			
			VAR Rank_ = [Conference Rank]
			VAR RankText = FORMAT(Rank_, "0")
			VAR LastDigit = RIGHT(RankText, 1)
			VAR Suffix =
			    SWITCH(
			        TRUE(),
			        Rank_ IN {11, 12, 13}, "th", -- special cases
			        LastDigit = "1", "st",
			        LastDigit = "2", "nd",
			        LastDigit = "3", "rd",
			        "th"
			    )
			RETURN
			UNICHAR(8203) & UNICHAR(8203) & RankText & Suffix
		lineageTag: 0b5877b1-6ae6-4a5d-9392-dbe27d27df6c

