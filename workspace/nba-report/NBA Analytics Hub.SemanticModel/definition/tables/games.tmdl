	measure HomeAwayLabel =
			
			IF(SELECTEDVALUE(teams[abbreviation]) = SELECTEDVALUE(games[hometeam_abbreviation]), SELECTEDVALUE(games[awayteam_abbreviation]), "@" & SELECTEDVALUE(games[hometeam_abbreviation]))
		lineageTag: 042022ea-dde8-44c7-857d-e9dbe8992471

		changedProperty = Name

	measure WinLabel = ```
			"data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A//www.w3.org/2000/svg%22%20width%3D%2238%22%20height%3D%2218%22%20viewBox%3D%220%200%2038%2018%22%3E%3Crect%20x%3D%220.5%22%20y%3D%220.5%22%20width%3D%2237%22%20height%3D%2217%22%20rx%3D%228.5%22%20fill%3D%22%23003D30%22%20stroke%3D%22%2300A370%22%2F%3E%3Ctext%20x%3D%2219%22%20y%3D%2250%25%22%20font-family%3D%22Segoe%20UI%2C%20sans-serif%22%20font-size%3D%2211%22%20fill%3D%22%23A3F7BF%22%20text-anchor%3D%22middle%22%20dominant-baseline%3D%22central%22%3EW%3C/text%3E%3C/svg%3E
