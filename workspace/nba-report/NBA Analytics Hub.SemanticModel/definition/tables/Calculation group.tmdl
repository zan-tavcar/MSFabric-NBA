	measure 'Is Last 5 Games' =
			
			VAR SelectedTeam = SELECTEDVALUE(teams[id])
			VAR AllGamesForTeam =
			    FILTER (
			        ALL (games),
			        (games[hometeam_id] = SelectedTeam || games[awayteam_id] = SelectedTeam)
			            && games[status] = "Final"
			    )
			VAR RankedGames =
			    ADDCOLUMNS (
			        AllGamesForTeam,
			        "GameRank",
			        RANKX (
			            AllGamesForTeam,
			            games[date],
			            ,
			            DESC
			        )
			    )
			VAR Top5GameIds =
			    SELECTCOLUMNS (
			        FILTER (RankedGames, [GameRank] <= 5),
			        "GameId", games[id]
			    )
			RETURN
			IF( PATHCONTAINS ( SUBSTITUTE(CONCATENATEX(Top5GameIds, [GameId], ","), ",", "|"), SELECTEDVALUE(games[id] )), TRUE(), BLANK())
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: bb45de61-eda6-498d-8f3d-cc1f3c9e5033

	measure 'Is Next 5 Games' =
			
			VAR SelectedTeam = SELECTEDVALUE(teams[id])
			VAR AllGamesForTeam =
			    FILTER (
			        ALL (games),
			        (games[hometeam_id] = SelectedTeam || games[awayteam_id] = SelectedTeam)
			            && games[status] <> "Final"
			    )
			VAR RankedGames =
			    ADDCOLUMNS (
			        AllGamesForTeam,
			        "GameRank",
			        RANKX (
			            AllGamesForTeam,
			            games[date],
			            ,
			            ASC
			        )
			    )
			VAR Top5GameIds =
			    SELECTCOLUMNS (
			        FILTER (RankedGames, [GameRank] <= 5),
