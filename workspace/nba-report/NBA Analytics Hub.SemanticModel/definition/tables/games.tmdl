	measure LoseLabel = ```
			"data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A//www.w3.org/2000/svg%22%20width%3D%2238%22%20height%3D%2218%22%20viewBox%3D%220%200%2038%2018%22%3E%3Crect%20x%3D%220.5%22%20y%3D%220.5%22%20width%3D%2237%22%20height%3D%2217%22%20rx%3D%228.5%22%20fill%3D%22%233D001D%22%20stroke%3D%22%23C40050%22%2F%3E%3Ctext%20x%3D%2219%22%20y%3D%2250%25%22%20font-family%3D%22Segoe%20UI%2C%20sans-serif%22%20font-size%3D%2211%22%20fill%3D%22%23FFAABF%22%20text-anchor%3D%22middle%22%20dominant-baseline%3D%22central%22%3EL%3C/text%3E%3C/svg%3E"
			
			```
		lineageTag: 67c00b7d-bc66-4336-aec7-8f8bed77eabd
		dataCategory: ImageUrl

		changedProperty = Name

		changedProperty = DataCategory

	measure GameResult = ```
			
			VAR SelectedTeam = SELECTEDVALUE(teams[abbreviation])
			VAR IsHome = SELECTEDVALUE(games[hometeam_abbreviation]) = SelectedTeam
			VAR TeamScore = IF(IsHome, SELECTEDVALUE(games[home_team_score]), SELECTEDVALUE(games[visitor_team_score]))
			VAR OpponentScore = IF(IsHome, SELECTEDVALUE(games[visitor_team_score]), SELECTEDVALUE(games[home_team_score]))
			RETURN IF(TeamScore > OpponentScore, [WinLabel], [LoseLabel])
			
			```
		lineageTag: 4178268c-3841-4919-8be3-792622165fa7
		dataCategory: ImageUrl

		changedProperty = Name

		changedProperty = DataCategory

	measure GameScore = SELECTEDVALUE(games[home_team_score]) & ":" & SELECTEDVALUE(games[visitor_team_score])
		lineageTag: 0874cc1a-cba9-429e-a06b-4361d30fac3a

		changedProperty = Name

	measure HomeAwayLabel2 =
			
			IF(SELECTEDVALUE(teams[abbreviation]) = CALCULATE(SELECTEDVALUE(games[hometeam_abbreviation]), CROSSFILTER(games[id],gamelines[gameid],None)), CALCULATE(SELECTEDVALUE(games[awayteam_abbreviation]), CROSSFILTER(games[id],gamelines[gameid],OneWay)), "@" & CALCULATE(SELECTEDVALUE(games[hometeam_abbreviation]), CROSSFILTER(games[id],gamelines[gameid],OneWay)))
		lineageTag: b83faab3-2514-4afd-99a0-6bb3dca7690a

